# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# If left blank or unreachable, an in-memory/fallback database will automatically be used for viva/demo
MONGODB_URI=mongodb://127.0.0.1:27017/ai_learning_assistant

# JWT Authentication Secret
JWT_SECRET=super_secret_ai_learning_assistant_jwt_key_2026

# AI / LLM Configuration
# Set to 'demo' to force high-quality offline AI Agent Mode
# Or provide your GEMINI_API_KEY / OPENAI_API_KEY
AI_PROVIDER=demo
AI_API_KEY=
AI_API_URL=
AI_MODEL=gemini-1.5-flash
